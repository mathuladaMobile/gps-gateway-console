<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS front for the Node server (server.mjs, run by pm2 on port 8080).
  Every request, /api included, goes to Node, which serves the SPA (with index.html fallback
  for routes like /login) and proxies /api to the API.
  Needs the IIS "URL Rewrite" and "Application Request Routing" modules, with
  ARR > Server Proxy Settings > "Enable proxy" turned on.
  Vite copies this file into dist/ on build.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy to Node" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:8080/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <!-- Let Node's 404/502 responses through instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
