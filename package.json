{
  "name": "gps-gateway-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "start": "node server.mjs",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs --only gps-console",
    "pm2:restart": "npm run build && pm2 restart gps-console",
    "pm2:dev": "pm2 start ecosystem.config.cjs --only gps-console-dev",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "dayjs": "^1.11.23",
    "pinia": "^3.0.4",
    "vue": "^3.5.12",
    "vue-i18n": "^11.4.23",
    "vue-router": "^4.4.5",
    "vuetify": "^3.7.4",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "typescript": "~5.6.3",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-tsc": "^3.3.14"
  }
}
